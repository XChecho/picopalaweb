# Server-only: base URL of the NestJS backend, used by the Next route handlers (BFF).
# Never exposed to the browser; the browser only calls same-origin /api/* routes.
# Production: https://picopalaapi.xchecho.com/api/v1
BACKEND_URL=http://localhost:4001/api/v1

# Server-only shared secret sent to the backend as `X-BFF-Key`. It must match the backend's value.
# With it the backend trusts `X-Client-IP` (real visitor IP) for rate limiting; without it every
# user shares the Next server's IP. REQUIRED when NODE_ENV=production (requests fail without it).
# Never prefix with NEXT_PUBLIC_, never log it, never commit a real value.
BFF_SHARED_SECRET=change-me-dev-secret

# Cloudflare Turnstile site key (public, inlined at build time). Enables the captcha on register.
# Empty/unset (development) = no widget and captchaToken optional. This is Cloudflare's test key
# that always passes; use the real site key in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Public site URL (metadata base).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
